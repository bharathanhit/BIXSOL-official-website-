rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Job Applications (open for candidate submissions)
    match /applications/{document} {
      allow read, write: if true;
    }
    
    match /jobApplications/{document} {
      allow read, write: if true;
    }
    
    // Sales Team Members (required for salesperson login)
    match /sales_team/{document} {
      allow read, write: if true;
    }
    
    // Sales Leads (required for dashboard cold-calling tasks)
    match /sales_leads/{document} {
      allow read, write: if true;
    }
  }
}
